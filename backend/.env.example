# ── Base de données PostgreSQL ────────────────────────────────────────────────
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE?schema=public
DATABASE_URL="postgresql://erp:erp_dev_password@localhost:5432/erp_db?schema=public"

# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Origines autorisées par CORS (séparées par des virgules)
CORS_ORIGIN="http://localhost:5173"

# ── Authentification ──────────────────────────────────────────────────────────
# À remplacer impérativement en production (ex: openssl rand -hex 32)
JWT_SECRET="changez-moi-en-production-avec-une-cle-aleatoire-longue"
JWT_EXPIRES_IN="8h"

# Compte admin créé par le seed
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# ── Entreprise (en-tête des factures PDF) ─────────────────────────────────────
COMPANY_NAME="Registre SARL"
COMPANY_ADDRESS="123 Avenue Mohammed V, Casablanca"
COMPANY_PHONE="+212 5 22 00 00 00"
COMPANY_EMAIL="contact@registre.ma"
COMPANY_ICE="001234567000089"

# ── Facturation ───────────────────────────────────────────────────────────────
CURRENCY="MAD"
TVA_RATE=0.20
